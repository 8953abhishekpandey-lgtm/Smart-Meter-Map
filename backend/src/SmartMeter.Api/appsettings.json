{
  "ConnectionStrings": {
    "SmartMeterDb": "Server=localhost,1433;Database=SmartMeterDb;User Id=smartmeter_app;Password=__set_via_env__;Encrypt=True;TrustServerCertificate=False;Max Pool Size=200;Command Timeout=60",
    "Redis": ""
  },
  "Auth": {
    "Enabled": true,
    "Mode": "Oidc",
    "Authority": "",
    "Audience": "smartmeter-api",
    "ClientId": "smartmeter-web",
    "Scope": "openid profile api://smartmeter-api/.default",
    "RequireHttpsMetadata": true
  },
  "Mdm": {
    "Mode": "Mock",
    "BaseUrl": "",
    "BatchSize": 500,
    "MaxParallelBatches": 4,
    "RetryCount": 3,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 60
  },
  "Ingestion": {
    "StoragePath": "/var/smartmeter/uploads",
    "MaxFileSizeBytes": 4294967296,
    "ChunkSizeBytes": 8388608,
    "MaxStoredErrors": 10000,
    "BulkCopyBatchSize": 50000,
    "DeleteFileAfterProcessing": true,
    "ServiceArea": { "MinLat": 6.0, "MinLon": 68.0, "MaxLat": 37.5, "MaxLon": 97.5 }
  },
  "Jobs": {
    "WorkersEnabled": true,
    "NightlyRefreshCron": "15 2 * * *",
    "TimeZone": "Asia/Kolkata",
    "DashboardEnabled": true
  },
  "RateLimiting": {
    "RequestsPerMinute": 3000,
    "AnalyticsConcurrency": 8
  },
  "ReverseProxy": {
    "TrustAllProxies": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Api": {
    "EnableDocs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
