{
  "ConnectionStrings": {
    "SmartMeterDb": "Server=localhost;Database=SmartMeterDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Command Timeout=60"
  },
  "Auth": {
    "Enabled": false,
    "Mode": "Dev"
  },
  "Ingestion": {
    "StoragePath": "./.uploads",
    "WatchFolder": "../../../data"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Api": {
    "EnableDocs": true
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" } }
    ]
  }
}
