# Copy to .env and change every secret. Never commit .env.
SA_PASSWORD=Change-Me-Sa#2026
APP_DB_PASSWORD=Change-Me-App#2026
# Generate a synthetic fleet on first start (0 = empty database, load your CIS/MDM files instead)
SEED_DEMO_METERS=300000
# Authentication: false = dev toggle (anonymous). For production set AUTH_ENABLED=true, AUTH_MODE=Oidc
AUTH_ENABLED=false
AUTH_MODE=Dev
AUTH_DEV_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-chars
AUTH_AUTHORITY=
# Live MDM consumption API (Mock | Http)
MDM_MODE=Mock
MDM_BASE_URL=
MDM_API_KEY=
# Optional ArcGIS API key (vector basemap styles). Empty = keyless public tile basemaps.
ARCGIS_API_KEY=
WEB_PORT=8080
