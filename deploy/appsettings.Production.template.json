{
  "//": "Copy to appsettings.Production.json next to SmartMeter.Api.dll, restrict file ACLs, fill in values. Secrets may instead be set as environment variables (e.g. ConnectionStrings__SmartMeterDb).",
  "ConnectionStrings": {
    "SmartMeterDb": "Server=YOUR-SQL-SERVER,1433;Database=SmartMeterDb;User Id=smartmeter_app;Password=SET-ME;Encrypt=True;TrustServerCertificate=False;Max Pool Size=200",
    "Redis": ""
  },
  "Auth": {
    "Enabled": true,
    "Mode": "Oidc",
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "api://smartmeter-api",
    "ClientId": "<spa-client-id>",
    "Scope": "openid profile api://smartmeter-api/access"
  },
  "Mdm": { "Mode": "Mock", "BaseUrl": "", "ApiKey": "" },
  "Ingestion": { "StoragePath": "D:\\SmartMeter\\uploads", "WatchFolder": "D:\\SmartMeter\\incoming", "WatchFolderScanMinutes": 1 },
  "Jobs": { "WorkersEnabled": true, "TimeZone": "Asia/Kolkata" },
  "Api": { "EnableDocs": false },
  "ReverseProxy": { "KnownProxies": [] },
  "Urls": "http://0.0.0.0:8080"
}
